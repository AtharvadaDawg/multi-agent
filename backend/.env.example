# ==============================================================================
# SleuthOps Multi-Agent DevOps SRE - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telemetry Source Mode
# ------------------------------------------------------------------------------
# Set to 'simulator' for offline simulated sandbox microservices.
# Set to 'aws' for live AWS EC2 CloudWatch monitoring and SSM remediation.
TELEMETRY_SOURCE=aws

# ------------------------------------------------------------------------------
# 2. AWS Infrastructure Configuration
# (Standard AWS credential chain is used: ~/.aws/credentials, IAM role, or env vars)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_EC2_INSTANCE_ID=i-0123456789abcdef0
AWS_CLOUDWATCH_METRIC_PERIOD=60
AWS_CPU_THRESHOLD_PERCENT=80.0
AWS_CLOUDWATCH_LOG_GROUP=
AWS_SSM_DOCUMENT=AWS-RunShellScript
AWS_VERIFICATION_POLL_INTERVAL=5.0
AWS_VERIFICATION_MAX_ATTEMPTS=12

# Optional explicit credentials (default is standard AWS IAM/CLI credential chain)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ------------------------------------------------------------------------------
# 3. LLM Configuration (Optional: system has deterministic high-precision fallbacks)
# ------------------------------------------------------------------------------
LLM_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MODEL_NAME=google/gemma-2-9b-it

# ------------------------------------------------------------------------------
# 4. Database & Event Bus
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./incidents.db
SYNC_DATABASE_URL=sqlite:///./incidents.db
TELEMETRY_INTERVAL_SECONDS=3.0
